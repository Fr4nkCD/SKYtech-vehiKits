								<Item class="ModuleScript" referent="RBX4D8FE4BA866C4644917C17B91AE04B1B">
									<Properties>
										<Content name="LinkedSource"><null></null></Content>
										<ProtectedString name="Source"><![CDATA[-- rotorLite Flight Physics
-- by SKYtech
-- An actual rotorLite module added as a backup for the VTOL modification.

local rotorLite = {
	States = {}
}

local VehicleUtils = require(script.Parent.Parent:WaitForChild("VehicleUtils"))
local Environment = require(script:WaitForChild("Environment"))
local Lift = require(script:WaitForChild("Lift"))
local Motion = require(script:WaitForChild("Motion"))

function rotorLite:Initialize(aircraft)
	local main = aircraft.Main
	local mainPart = main.Main

	self.States[aircraft] = {
		AircraftInstance = aircraft,
		Utils = VehicleUtils,
		System = {
			Collective = 0,
			Roll = 0,
			Pitch = 0,
			Yaw = 0,
			Forward = 0,
			DynamicForwardDrag = 0,
			SidewaysSpeed = 0,
			Velocity = Vector3.zero,
			Direction = Vector3.zero,
			RollAccumulated = 0,
			MotionCFrame = CFrame.new(),
			MaxForce = 0,
			OnClient = false,
		},
		Settings = {},
		Connections = {},
		Components = {
			MainPart = mainPart,
			Motion = mainPart.Motion,
			Lift = mainPart.Lift,
			Gravity = mainPart.Gravity,
			Stats_ = main.Stats,
		},
		IgnoredObjects = {aircraft},
		EnvironmentData = {},
		ThrustData = {}
	}

	local state = self.States[aircraft]
	local Settings = aircraft:FindFirstChild("Settings")

	for attrName, attrValue in pairs(Settings:GetAttributes()) do
		VehicleUtils.UpdateSetting(attrName, attrValue, state.Settings)
	end	

	if VehicleUtils.IsClient() then
		VehicleUtils.SyncLegacyValues(Settings, state.Connections)
	end

	table.insert(state.Connections, Settings.AttributeChanged:Connect(function(attrName)
		local attrValue = Settings:GetAttribute(attrName)
		if attrValue == nil then return end
		VehicleUtils.UpdateSetting(attrName, attrValue, state.Settings)
	end))

	state.RayFilter = RaycastParams.new()
	state.RayFilter.FilterType = Enum.RaycastFilterType.Exclude

	self:Reset(aircraft)
end

function rotorLite:GetState(aircraft)
	return self.States[aircraft]
end

function rotorLite:Reset(aircraft)
	local state = self.States[aircraft]
	local System = state.System
	local Settings = state.Settings
	local Components = state.Components
	local mainPart = Components.MainPart

	local physicsScale = VehicleUtils.Max(Settings.Modifications.PhysicsScale or Settings.Advanced.PhysicsScale, 0.001)
	local mainCFrame = mainPart.CFrame
	local velocity = mainPart.AssemblyLinearVelocity / physicsScale
	local bankAngle = -VehicleUtils.Deg(VehicleUtils.GetRoll(mainCFrame)) + 360

	System.MaxForce = VehicleUtils.Clamp(System.Collective / 0.1 + velocity.Magnitude / 20, 0, 1) * (if Components.Stats_:GetAttribute("Active") == true then 1 else 0)
	System.Forward = -mainCFrame:VectorToObjectSpace(velocity).Z
	System.SidewaysSpeed = mainCFrame:VectorToObjectSpace(velocity).X
	System.Velocity = velocity * physicsScale
	System.RollAccumulated = VehicleUtils.Rad(bankAngle)
	System.Direction = mainCFrame.LookVector * 1e6
	System.MotionCFrame = mainCFrame
	
	Components.Motion.CFrame = System.MotionCFrame
end

function rotorLite:Update(aircraft, dt, onClient)	
	local state = self.States[aircraft]
	if not state then return end
	
	local System = state.System
	local Components = state.Components
	local mainPart = Components.MainPart
	
	System.OnClient = onClient

	if not mainPart:IsGrounded() then
		-- Ordered calculation pipeline execution
		Environment.Update(dt, state)
		Lift.Update(dt, state)
		Motion.Update(dt, state)
	else
		local mainCFrame = mainPart.CFrame
		local physicsScale = VehicleUtils.Max(state.Settings.Modifications.PhysicsScale or state.Settings.Advanced.PhysicsScale, 0.001)
		local velocity = mainPart.AssemblyLinearVelocity / physicsScale
		local bankAngle = -VehicleUtils.Deg(VehicleUtils.GetRoll(mainCFrame)) + 360
		
		System.MaxForce = VehicleUtils.Clamp(System.Collective / 0.1 + velocity.Magnitude / 20, 0, 1) * (if Components.Stats_:GetAttribute("Active") == true then 1 else 0)
		System.Forward = -mainCFrame:VectorToObjectSpace(velocity).Z
		System.SidewaysSpeed = mainCFrame:VectorToObjectSpace(velocity).X
		System.Velocity = velocity * physicsScale
		System.RollAccumulated = VehicleUtils.Rad(bankAngle)
		System.Direction = mainCFrame.LookVector * 1e6
		System.MotionCFrame = mainCFrame
		
		Components.Motion.CFrame = System.MotionCFrame
	end
end

function rotorLite:Cleanup(aircraft)
	local state = self.States[aircraft]
	if not state then return end

	for _, connection in pairs(state.Connections) do
		connection:Disconnect()
	end
	state.Connections = nil
	self.States[aircraft] = nil
end

return rotorLite]]></ProtectedString>
										<string name="ScriptGuid">{3079AD2E-40CD-473E-BE7B-235F4EBBD73F}</string>
										<BinaryString name="AttributesSerialize"></BinaryString>
										<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
										<bool name="DefinesCapabilities">true</bool>
										<string name="Name">VTOL_FlightPhysics</string>
										<int64 name="SourceAssetId">-1</int64>
										<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
									</Properties>
									<Item class="ModuleScript" referent="RBXCA968A7FC2764485BBE33EED2B29D51C">
										<Properties>
											<Content name="LinkedSource"><null></null></Content>
											<ProtectedString name="Source"><![CDATA[-- Environment Module
-- Handles atmospheric metrics, altitude ceiling clamping, and collective scaling
local Environment = {}

function Environment.Update(dt, state)
	local Utils = state.Utils
	local System = state.System
	local Settings = state.Settings
	local Components = state.Components

	local Stats_ = Components.Stats_
	local mainPart = Components.MainPart
	local mainCFrame = mainPart.CFrame
	local position = mainPart.Position
	local altitude = position.Y

	local physicsScale = Utils.Max(Settings.Modifications.PhysicsScale or Settings.Advanced.PhysicsScale, 0.001)
	local _aircraftStatistics = Settings.AircraftStatistics

	local _sensitivity = Utils.Max(_aircraftStatistics.Sensitivity, 0.001)
	local _maxSpeed = Utils.Max(_aircraftStatistics.MaxSpeed * physicsScale, 0.001)
	local _maxAltitude = Utils.Max(_aircraftStatistics.MaxAltitude * physicsScale, 0.001)
	local _rateOfClimb = _aircraftStatistics.RateOfClimb * physicsScale

	local velocity = mainPart.AssemblyLinearVelocity / physicsScale
	local bankAngle = -Utils.Deg(Utils.GetRoll(mainCFrame)) + 360
	local isInverted = bankAngle % 360 >= 90 and bankAngle % 360 <= 270
	local invertedBankAngle = Utils.Deg(Utils.GetRoll(mainCFrame * Utils.CFAngles(0, 0, Utils.Pi))) - 360
	local pitchRad, yawAngle, _ = mainCFrame:ToEulerAnglesYXZ()
	local pitchAngle = Utils.Deg(pitchRad)

	local collective = Utils.Clamp(System.Collective / 0.1 + velocity.Magnitude / 20, 0, 1) * (if Stats_:GetAttribute("Active") == true then 1 else 0)
	local forceAlpha = 1 - Utils.Exp(-10 * (0.5 + _sensitivity / 2) * dt)
	System.MaxForce = Utils.Lerp(System.MaxForce, collective, forceAlpha)

	state.EnvironmentData = {
		PhysicsScale = physicsScale,
		Velocity = velocity,
		BankAngle = bankAngle,
		IsInverted = isInverted,
		InvertedBankAngle = invertedBankAngle,
		PitchRad = pitchRad,
		PitchAngle = pitchAngle,
		YawAngle = yawAngle,
		MaxSpeed = _maxSpeed,
		MaxAltitude = _maxAltitude,
		RateOfClimb = _rateOfClimb,
		Sensitivity = _sensitivity
	}
end

return Environment]]></ProtectedString>
											<string name="ScriptGuid">{C34FC46A-79EF-4F8B-9A37-74567D633948}</string>
											<BinaryString name="AttributesSerialize"></BinaryString>
											<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
											<bool name="DefinesCapabilities">true</bool>
											<string name="Name">Environment</string>
											<int64 name="SourceAssetId">-1</int64>
											<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
										</Properties>
									</Item>
									<Item class="ModuleScript" referent="RBX7220ECA9C77F431FAFA84B600B96B226">
										<Properties>
											<Content name="LinkedSource"><null></null></Content>
											<ProtectedString name="Source"><![CDATA[-- Motion Module
-- Manages spatial orientation matrices, auto-coordinated bank target curves, and constraints
local Motion = {}

function Motion.Update(dt, state)
	local Utils = state.Utils
	local System = state.System
	local Settings = state.Settings
	local Components = state.Components
	local Env = state.EnvironmentData
	local Thr = state.ThrustData

	local mainPart = Components.MainPart
	local motion = Components.Motion
	local lift = Components.Lift
	local gravity = Components.Gravity

	local mainCFrame = mainPart.CFrame
	local position = mainPart.Position
	local globalGravity = workspace.Gravity

	lift.MaxForce = Thr.Mass * 100 * System.MaxForce
	motion.MaxTorque = Thr.Mass * 2000 * System.MaxForce
	lift.VectorVelocity = System.Velocity

	motion.MaxAngularVelocity = Utils.Clamp(Env.Sensitivity * 3, 1, 3)

	if System.MaxForce > 0.01 then
		local alpha = 1 - Utils.Exp(-Env.Sensitivity / 0.5 * dt)
		local nosePosition = mainCFrame.LookVector * 1e6
		
		local rawMousePos = System.MousePosition
		local validMouse = rawMousePos and rawMousePos ~= Vector3.zero and rawMousePos.Magnitude > 0.001
		
		local targetPosition = if validMouse then rawMousePos else (position + nosePosition)
		local targetDir = (targetPosition - position).Unit
		
		System.Direction = System.Direction:Lerp(targetDir, alpha).Unit

		local targetPosition = position + (System.Direction * 1e6)
		local flatMask = Utils.V3New(1, 0, 1)
		local start2D = nosePosition * flatMask
		local target2D = targetPosition * flatMask

		local maxAngle = Utils.Pi / 4 + Utils.Pi / 8 * Env.Sensitivity

		if start2D.Magnitude > 0.001 and target2D.Magnitude > 0.001 then
			local turnAngle = math.acos(Utils.Clamp(start2D.Unit:Dot(target2D.Unit), -1, 1))
			local turnSign = Utils.Sign(Vector3.yAxis:Dot(start2D:Cross(target2D)))

			local cleanForwardSpeed = Utils.Abs(System.Forward)
			local speedFactor = Utils.Min(cleanForwardSpeed / 30, 1.5)

			local manualRollTarget = System.Roll * maxAngle
			
			local rollSensitivity = Env.Sensitivity * 2.5 * (if System.OnClient then 5 else 1)
			local autoRollTarget = (turnAngle ^ (1 + Env.Sensitivity) * turnSign) * rollSensitivity * speedFactor
			local manualRollOverride = 1 - Utils.Abs(System.Roll)
			autoRollTarget = Utils.Clamp(autoRollTarget * manualRollOverride + manualRollTarget, -maxAngle, maxAngle)

			local dive = 1 - Utils.Max(Utils.Abs(Env.PitchAngle) - 60, 0) / 30
			System.RollAccumulated = Utils.Lerp(System.RollAccumulated * dive, autoRollTarget, alpha)
		end

		local finalRollAngle = Utils.Clamp(System.RollAccumulated, -maxAngle, maxAngle)
		System.MotionCFrame = CFrame.lookAt(position, targetPosition) * Utils.CFAngles(0, 0, finalRollAngle)
	else
		System.Forward = -mainCFrame:VectorToObjectSpace(Env.Velocity).Z
		System.SidewaysSpeed = mainCFrame:VectorToObjectSpace(Env.Velocity).X
		System.Velocity = Utils.V3Zero
		System.Direction = mainCFrame.LookVector * 1e6
		System.MotionCFrame = mainCFrame
	end

	local speedGain = Utils.Min(System.MaxForce + Env.Velocity.Magnitude / 10, 1)
	gravity.Force = Utils.V3New(0, Thr.Mass * Utils.Max(globalGravity - 35, 0) * speedGain, 0)

	local responsiveness = Utils.Clamp((10 + Utils.Max(Settings.AircraftStatistics.TorqueResponsiveness, 0.001)) * Thr.StabilityAlpha, 0, 0.25) 
	motion.CFrame = motion.CFrame:Lerp(System.MotionCFrame, responsiveness)

	-- Overwrite/bypass debug safety logic
	if not lift.Enabled then
		System.Forward = -mainCFrame:VectorToObjectSpace(Env.Velocity).Z
		System.SidewaysSpeed = mainCFrame:VectorToObjectSpace(Env.Velocity).X
		System.Velocity = Env.Velocity * Env.PhysicsScale
	end
	if not motion.Enabled then
		System.RollAccumulated = Utils.Rad(Env.BankAngle)
		System.Direction = mainCFrame.LookVector * 1e6
		System.MotionCFrame = mainCFrame
	end
end

return Motion]]></ProtectedString>
											<string name="ScriptGuid">{C57DD8D2-5BFC-48BA-9C22-423B8BF6FCE6}</string>
											<BinaryString name="AttributesSerialize"></BinaryString>
											<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
											<bool name="DefinesCapabilities">true</bool>
											<string name="Name">Motion</string>
											<int64 name="SourceAssetId">-1</int64>
											<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
