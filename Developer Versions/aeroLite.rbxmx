									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
							</Item>
							<Item class="Folder" referent="RBX5627F90F765E44408EF7FE833321807D">
								<Properties>
									<BinaryString name="AttributesSerialize"></BinaryString>
									<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
									<bool name="DefinesCapabilities">true</bool>
									<string name="Name">BackupModules</string>
									<int64 name="SourceAssetId">-1</int64>
									<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
								</Properties>
								<Item class="ModuleScript" referent="RBXA203322DCA6945759FA9ED20C19CD964">
									<Properties>
										<Content name="LinkedSource"><null></null></Content>
										<ProtectedString name="Source"><![CDATA[-- VTOL Bridge Module
local Bridge = {
	States = {}
}

local aeroLite = script.Parent
local modules = script.Parent.Parent
local Utils = require(modules:WaitForChild("VehicleUtils"))
local Dynamics = require(script:WaitForChild("Dynamics"))

local rotorLite = nil
local usingBackup = false

local rotorLiteModule = modules:FindFirstChild("rotorLite")
if not rotorLiteModule then
	warn("VTOL: rotorLite not found, switching to backup.")
	rotorLiteModule = script.Parent:WaitForChild("VTOL_FlightPhysics")
	usingBackup = true
end
rotorLite = require(rotorLiteModule)

function Bridge:Initialize(aircraft)
	local main = aircraft.Main
	local mainPart = main.Main
	local VTOL_Attachment = mainPart.VTOL

	self.States[aircraft] = {
		System = {
			VTOL = false, Roll = 0, Pitch = 0, Yaw = 0, Collective = 0, Percent = 0,
			LookVector = Vector3.zero, Forward = 0, Forward_Drag = 0, Sideways_Speed = 0,
			Velocity = Vector3.zero, Direction = CFrame.new(), MotionCFrame = CFrame.new(), MaxForce = Vector2.zero,
		},
		Settings = {},
		Connections = {},
		Components = {
			StateWrapper = aircraft.System, Stats_ = main.Stats, MainPart = mainPart,
			Motion = mainPart.Motion, Turn = mainPart.Turn, Thrust = mainPart.Thrust,
			Lift = mainPart.Lift, Gravity = mainPart.Gravity, VTOL_Lift = VTOL_Attachment.Lift,
			VTOL_Motion = VTOL_Attachment.Motion, VTOL_Gravity = VTOL_Attachment.Gravity,
			VTOL_UpdateEvent = main.Mods.VTOL.Update
		},
		Step = 0,
		ForwardState = require(aircraft.System),
		VTOLState = {},
		Utils = Utils
	}

	local state = self.States[aircraft]
	local Settings = aircraft:FindFirstChild("Settings")

	for attrName, attrValue in pairs(Settings:GetAttributes()) do
		Utils.UpdateSetting(attrName, attrValue, state.Settings)
	end	

	table.insert(state.Connections, Settings.AttributeChanged:Connect(function(attrName)
		local attrValue = Settings:GetAttribute(attrName)
		if attrValue == nil then return end
		Utils.UpdateSetting(attrName, attrValue, state.Settings)

		if attrName:find("Acceleration") then
			state.VTOLState.Settings.AircraftStatistics.Acceleration = state.Settings.AircraftStatistics.VTOLAcceleration
		end
	end))

	self:Reset(aircraft)
	rotorLite:Initialize(aircraft)

	state.VTOLState = rotorLite:GetState(aircraft)
	local VTOLState = state.VTOLState
	VTOLState.Components.Lift = state.Components.VTOL_Lift
	VTOLState.Components.Motion = state.Components.VTOL_Motion
	VTOLState.Components.Gravity = state.Components.VTOL_Gravity
	VTOLState.Settings.AircraftStatistics.Acceleration = state.Settings.AircraftStatistics.VTOLAcceleration

	return state.System
end

function Bridge:GetState(aircraft) return self.States[aircraft] end

function Bridge:Reset(aircraft)
	local state = self.States[aircraft]
	state.Components.VTOL_Motion.CFrame = state.Components.MainPart.CFrame
end

function Bridge:Update(aircraft, dt, onClient)
	local state = self.States[aircraft]
	if not state then return end

	if usingBackup then
		local mainModule = modules:FindFirstChild("rotorLite")
		if mainModule then
			rotorLite = require(mainModule)
			usingBackup = false
			local oldVTOLSystem = state.VTOLState.System
			rotorLite:Initialize(aircraft)

			state.VTOLState = rotorLite:GetState(aircraft)
			local VTOLState = state.VTOLState
			VTOLState.Components.Lift = state.Components.VTOL_Lift
			VTOLState.Components.Motion = state.Components.VTOL_Motion
			VTOLState.Components.Gravity = state.Components.VTOL_Gravity
			VTOLState.Settings.AircraftStatistics.Acceleration = state.Settings.AircraftStatistics.VTOLAcceleration

			VTOLState.System.Forward = oldVTOLSystem.Forward
			VTOLState.System.SidewaysSpeed = oldVTOLSystem.SidewaysSpeed
			VTOLState.System.Velocity = oldVTOLSystem.Velocity
			VTOLState.System.RollAccumulated = oldVTOLSystem.RollAccumulated
		end
	end

	state.Step += dt
	local System = state.System
	local Components = state.Components
	local VTOLSystem = state.VTOLState.System

	-- Run extracted mathematical physics calculations
	Dynamics.Update(dt, state)

	Components.Stats_:SetAttribute("VTOL/Active", System.VTOL)
	Components.Stats_:SetAttribute("VTOL/Percent", System.Percent * 100)

	if state.Step >= 0.5 and onClient then
		Components.VTOL_UpdateEvent:FireServer(System.VTOL, System.Percent * 100)
		state.Step = 0
	end

	VTOLSystem.Collective = System.Collective
	VTOLSystem.Percent = System.Percent
	VTOLSystem.Roll = System.Roll
	VTOLSystem.Pitch = System.Pitch
	VTOLSystem.Yaw = System.Yaw
	VTOLSystem.MousePosition = System.MousePosition

	rotorLite:Update(aircraft, dt, onClient)
end

function Bridge:Cleanup(aircraft)
	rotorLite:Cleanup(aircraft)
	local state = self.States[aircraft]
	if not state then return end
	for _, connection in pairs(state.Connections) do connection:Disconnect() end
	state.Connections = nil
	self.States[aircraft] = nil
end

return Bridge]]></ProtectedString>
										<string name="ScriptGuid">{A0A6C9D2-E962-4D67-B3A5-D174D965FC44}</string>
										<BinaryString name="AttributesSerialize"></BinaryString>
										<SecurityCapabilities name="Capabilities">17996771963439872</SecurityCapabilities>
										<bool name="DefinesCapabilities">true</bool>
